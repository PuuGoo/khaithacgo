# ==============================================================================
# CẤU HÌNH KẾT NỐI MONGODB ATLAS / LOCAL CHO LUMBER TYCOON 3D
# ==============================================================================

# Cách 1: Sử dụng MongoDB Atlas (Khuyến nghị cho lưu trữ đám mây)
# Lấy chuỗi kết nối từ MongoDB Atlas Dashboard -> Connect -> Drivers:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# Cách 2: Sử dụng MongoDB Cục Bộ (Localhost)
MONGODB_URI=mongodb://127.0.0.1:27017

# Tên Database (mặc định: lumber_tycoon)
DB_NAME=lumber_tycoon
